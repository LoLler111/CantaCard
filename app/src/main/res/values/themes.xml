<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema della finestra basato sul framework (niente AppCompat): Compose disegna il resto. -->
    <style name="Theme.CantaCard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Visualizzazione tessera: sempre chiara (anche col tema scuro), niente lampo nero all'apertura.
         Definita solo qui, non in values-night. -->
    <style name="Theme.CantaCard.Code" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Scanner: sfondo nero dietro l'anteprima della fotocamera. -->
    <style name="Theme.CantaCard.Scan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
