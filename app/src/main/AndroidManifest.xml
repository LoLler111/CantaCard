<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo per scansionare le tessere; l'app si installa anche senza fotocamera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Solo per il catalogo negozi (e, più avanti, le icone): sempre facoltativa. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CantaCardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CantaCard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CantaCard.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Da scorciatoie e widget si apre in un task suo: non chiude la lista o un modulo aperti. -->
        <activity
            android:name=".ShowCardActivity"
            android:exported="false"
            android:taskAffinity="dev.cantacard.card"
            android:theme="@style/Theme.CantaCard.Code" />

        <activity
            android:name=".StorePickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EditCardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Immagine condivisa da un'altra app: nuova tessera con quell'immagine. Nessuna interfaccia. -->
        <activity
            android:name=".ShareImageActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".scan.PhotoActivity"
            android:exported="false"
            android:theme="@style/Theme.CantaCard.Scan" />

        <activity
            android:name=".scan.ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.CantaCard.Scan" />

        <!-- Widget: tessere preferite e tessera singola (RemoteViews classici). -->
        <receiver
            android:name=".widget.FavoritesWidget"
            android:exported="false"
            android:label="@string/widget_favorites_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>

        <receiver
            android:name=".widget.CardWidget"
            android:exported="false"
            android:label="@string/widget_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_info" />
        </receiver>

        <activity
            android:name=".widget.CardWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
